{
  "name": "dreamexpressbd",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --output-hashing=all --configuration production",
    "deploy:iis": "powershell -ExecutionPolicy Bypass -File .\\scripts\\deploy-iis.ps1",
    "deploy:verify-live": "powershell -ExecutionPolicy Bypass -File .\\scripts\\verify-live-deploy.ps1",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "flowbite": "^4.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "ngx-cookie-service": "^21.1.0",
    "ngx-quill": "^30.0.1",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "swiper": "^12.1.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
